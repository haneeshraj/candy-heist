# Copy to .env.local for development, and set the same names in Vercel for
# the live site. Never commit the real values.

# The Atlas connection string: the heist-dev user here, heist-prod on the
# live site. Each can only reach its own database.
MONGODB_URI=
# candy_heist_dev here; candy_heist_prod on the live site.
MONGODB_DB=candy_heist_dev

# Candy Haven's API: the Firebase project Haven signs in to, and the two
# account ids allowed in, separated by a comma.
FIREBASE_PROJECT_ID=
HAVEN_ALLOWED_UIDS=

# Release covers, in Supabase Storage. The project's URL; its secret key
# (sb_secret_..., server only, never NEXT_PUBLIC_); and the bucket: covers-dev
# here, covers on the live site. Both buckets are public, 1 MB, image/webp.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_COVERS_BUCKET=covers-dev
