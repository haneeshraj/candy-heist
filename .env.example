# Copy to .env.local for development, and set the same names in Vercel for
# the live site. Never commit the real values.

# The Atlas connection string: the heist-dev user here, heist-prod on the
# live site. Each can only reach its own database.
MONGODB_URI=
# candy_heist_dev here; candy_heist_prod on the live site.
MONGODB_DB=candy_heist_dev

# Candy Haven's API: the Firebase project Haven signs in to, and the two
# account ids allowed in, separated by a comma.
FIREBASE_PROJECT_ID=
HAVEN_ALLOWED_UIDS=

# Release covers, in Supabase Storage. The project's URL; its secret key
# (sb_secret_..., server only, never NEXT_PUBLIC_); and the bucket: covers-dev
# here, covers on the live site. Both buckets are public, 1 MB, image/webp.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_COVERS_BUCKET=covers-dev

# Payments, through Stripe: test keys here (sk_test_, pk_test_), live keys
# on the live site. The webhook secret is the endpoint's (whsec_), or the
# one `stripe listen` prints locally.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Candy's Google account: calendar busy times, sessions with Meet links,
# receipts from his Gmail. The OAuth client's id and secret; 32 random bytes,
# hex, as the key for /api/google/connect?key= (base64 breaks in a link); and
# 32 random bytes, base64, sealing his sign-in in the database. See README,
# Bookings and payments.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CONNECT_KEY=
GOOGLE_TOKEN_KEY=
# Optional: where Candy's booking notes go, if not his connected Gmail.
BOOKING_NOTIFY_EMAIL=

# Consultations' tracks, in the project's Vercel Blob store (public). Vercel
# adds the token when the store is connected to the project; `vercel env pull`
# brings it here. The cron secret is any long random string, set in Vercel:
# Vercel Cron sends it to the daily sweep (vercel.json).
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
